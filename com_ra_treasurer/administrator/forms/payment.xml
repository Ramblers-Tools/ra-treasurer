<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Ramblers\Component\Ra_tools\Administrator\Field">
    <fieldset name="payment" label="COM_RA_TREASURER_FIELDSET_PAYMENT">
        <field
            name="id"
            type="hidden"
            filter="uint"
        />
        <field
            name="date_paid"
            type="calendar"
            label="Date payment received"
            description="Date the payment was received by the bank."
            format="%Y-%m-%d"
            filter="string"
            showtime="false"
            todaybutton="true"
            required="true"
        />
        <field
            name="amount_paid"
            type="number"
            label="Amount Paid"
            description="Value of the payment made. Must be a positive number."
            filter="float"
            min="0.01"
            max="99999.99"
            step="0.01"
            required="true"
        />
        <field
            name="payment_created"
            type="calendar"
            label="Payment Created"
            format="%Y-%m-%d %H:%M:%S"
            filter="user_utc"
            showtime="true"
            readonly="true"
        />
        <field
            name="payment_created_by"
            type="modifiedby"
            label="Payment Created By"
            readonly="true"
        />
        <field
            name="payment_modified"
            type="calendar"
            label="Payment Updated"
            format="%Y-%m-%d %H:%M:%S"
            filter="user_utc"
            showtime="true"
            readonly="true"
        />
        <field
            name="payment_modified_by"
            type="modifiedby"
            label="Payment Updated By"
            readonly="true"
        />
        <field name="state" type="hidden" filter="int" />
        <field name="checked_out" type="hidden" filter="unset" />
        <field name="checked_out_time" type="hidden" filter="unset" />
    </fieldset>
</form>
