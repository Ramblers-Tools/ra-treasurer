<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Ramblers\Component\Ra_tools\Administrator\Field">
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" label="JGLOBAL_FIELD_ID_LABEL" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="amount_paid" filter="safehtml" type="text" label="Amount paid" description="Amount of the payment received"/>
    <field name="date_paid" class="inputbox" format="%Y-%m-%d" timeformat="24" filter="user_utc" translateformat="false" showtime="false" 
           singleheader="false" 
           todaybutton="true" 
           weeknumbers="false" 
           filltable="true" 
           type="calendar" 
           label="Date paid" 
           description="When the payment was received" />

    <field name="payment_created" class="inputbox" format="%Y-%m-%d" timeformat="12" filter="server_utc" translateformat="false" showtime="false" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" 
           label="Payment created" 
           description="When the payment was recorded" />
    <field name="payment_created_by" 
           type="modifiedby" default="0" 
           label="Payment created by" 
           description="The person who recorded the payment" 
           readonly="true" />
    <field name="payment_modified" class="inputbox" format="%Y-%m-%d" timeformat="12" filter="server_utc" translateformat="false" showtime="false" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" 
           label="Payment updated" 
           description="When the payment was updated" />
    <field name="payment_modified_by" 
           type="modifiedby" default="0" 
           label="Payment updated by" 
           description="The person who updated the payment" 
           readonly="true" />    
    
     <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>

    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" type="hidden" filter="unset"/>          
           
           
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
  </fieldset>
</form>
