<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" hint="COM_RA_TREASURER_SEARCH_FILTER_SUBMIT"
               label="COM_RA_TREASURER_BOOKINGS_SEARCH_FILTER_DESC"
               class="js-stools-search-string" />

        

    </fields>
    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_RA_TREASURER_LIST_FULL_ORDERING"
               description="COM_RA_TREASURER_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="e.event_date ASC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="e.event_date ASC">Event date ASC</option>
            <option value="e.event_date DESC">Event date DESC</option>
            <option value="e.title ASC">Event title ASC</option>
            <option value="e.title DESC">Event date DESC</option>
            <option value="a.created ASC">Booking date ASC</option>
            <option value="a.created DESC">Booking date DESC</option>
            <option value="p.preferred_name ASC">Member name ASC</option>
            <option value="p.preferred_name DESC">Member name DESC</option>
            <option value="a.num_places ASC">Num places ASC</option>
            <option value="a.num_places DESC">Num places DESC</option>

        </field>

       <field name="limit"
               type="limitbox"
               label="COM_RA_TREASURER_LIST_LIMIT"
               description="COM_RA_TREASURER_LIST_LIMIT_DESC"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>
</form>
